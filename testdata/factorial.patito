programa factorial_func;

entero factorial(n : entero)
{
    vars
        fact, i: entero;
    {
        fact = 1;
        i = 1;

        mientras (i <= n) haz 
        {
            fact = fact * i;
            i = i + 1;
        };
    }
    retornar fact;
};

inicio
{
    escribe(factorial(5));
}
fin