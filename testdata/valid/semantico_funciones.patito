programa funciones ;
vars
    resultado : entero;

entero suma( a : entero, b : entero ) {
    vars
        temp : entero;
    {
        temp = a + b ;
    }
} ;

nula imprimir( val : entero ) {
    {
        escribe( val ) ;
    }
} ;

inicio
{
    resultado = suma( 10, 20 ) ;
    imprimir( resultado ) ;
}
fin