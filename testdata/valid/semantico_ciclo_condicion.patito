programa flujo ;
vars
    i : entero;
    total : entero;
inicio
{
    i = 0 ;
    total = 0 ;
    mientras ( i != 10 ) haz
    {
        total = total + i ;
        i = i + 1 ;
    } ;
    si ( total > 0 )
    {
        escribe( "total positivo:", total ) ;
    }
    sino
    {
        escribe( "total cero o negativo" ) ;
    } ;
}
fin